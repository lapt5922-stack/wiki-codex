# ==============================================================================
# WIKI CODEX - CẤU HÌNH MÔI TRƯỜNG (ENVIRONMENT CONFIGURATION)
# ==============================================================================
# Sao chép file này thành .env.local để chạy cục bộ hoặc cấu hình trên Cloud.
# Nếu bỏ trống DATABASE_URL, hệ thống tự động dùng kho dữ liệu JSON cục bộ (.data/)
# để bạn có thể chạy thử ngay lập tức mà không cần cài PostgreSQL.

# --- 1. Cơ sở dữ liệu PostgreSQL (Local / Neon / Supabase / Railway) ---
# Ví dụ chạy cục bộ:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/wiki_codex
# Ví dụ Neon / Supabase (tự động bật SSL khi có sslmode=require hoặc DATABASE_SSL=true):
# DATABASE_URL=postgresql://user:pass@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DATABASE_SSL=false

# --- 2. Bảo mật Phiên đăng nhập (Auth Session) ---
# Thay bằng chuỗi ngẫu nhiên dài ít nhất 32 ký tự khi đưa lên môi trường thật
AUTH_SECRET=wiki-codex-dev-secret-change-me-in-production-2026

# --- 3. Cổng Web Công khai & 1-Click Push Tự động ---
# Địa chỉ công khai của trang web (dùng để tạo link chia sẻ & OpenGraph SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL Webhook Deploy tự động (Vercel Deploy Hook / Netlify Build Hook / Cloudflare Pages / Render / GitHub)
# Khi cấu hình, bấm "Đẩy lên Web Công khai (1-Click Push)" sẽ tự động kích hoạt build/deploy Cloud
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_SECRET=

# --- 4. Lưu trữ Hình ảnh / CDN Quy mô lớn (Tùy chọn) ---
# Đường dẫn CDN công khai cho hàng chục nghìn ảnh (Cloudflare R2 / AWS S3 / Supabase Storage)
NEXT_PUBLIC_MEDIA_CDN_URL=
